classDiagram
    class Owner {
        name: str
        available_minutes: int
        preferences: dict
        pets: list
        add_pet(pet)
        set_available_time(minutes)
        update_preferences(preferences)
        get_all_tasks() list
    }

    class Pet {
        name: str
        species: str
        tasks: list
        add_task(task)
        remove_task(task)
        has_been_fed_today() bool
        has_been_walked_today() bool
    }

    class Task {
        name: str
        category: str
        duration_minutes: int
        priority: int
        frequency: str
        scheduled_start: datetime_or_None
        completed_at: datetime_or_None
        mark_complete()
        is_completed() bool
        next_due_date() datetime_or_None
    }

    class Scheduler {
        owner: Owner
        daily_plan: list_of_pet_task_pairs
        generate_plan()
        explain_plan() str
        sort_by_time() list
        filter_tasks(pet_name, completed) list
        mark_task_complete(pet, task)
        detect_conflicts() list
    }

    Owner "1" --> "0..*" Pet : has
    Pet "1" --> "0..*" Task : has
    Scheduler --> "1" Owner : plans for
    Scheduler ..> Task : selects and orders
